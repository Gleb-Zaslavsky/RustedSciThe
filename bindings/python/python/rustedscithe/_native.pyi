    def dot(self, other: ExprVector) -> Expr: ...
    def evaluate(self, values: Sequence[float]) -> NDArray[np.float64]: ...


class ExprMatrix:
    """Immutable native symbolic matrix; rows and evaluations use row-major order."""
    def __init__(self, rows: Sequence[Sequence[Expr]]) -> None: ...
    @staticmethod
    def zeros(nrows: int, ncols: int) -> ExprMatrix: ...
    @staticmethod
    def identity(size: int) -> ExprMatrix: ...
    def shape(self) -> tuple[int, int]: ...
    def variables(self) -> list[str]: ...
    def get(self, row: int, column: int) -> Expr: ...
    def row(self, index: int) -> ExprVector: ...
    def column(self, index: int) -> ExprVector: ...
    def transpose(self) -> ExprMatrix: ...
    def diff(self, variable: str) -> ExprMatrix: ...
    def simplify(self) -> ExprMatrix: ...
    def substitute_expr(self, variable: str, value: Expr) -> ExprMatrix: ...
    def matvec(self, vector: ExprVector) -> ExprVector: ...
    def matmul(self, other: ExprMatrix) -> ExprMatrix: ...
    def hadamard(self, other: ExprMatrix) -> ExprMatrix: ...
    def trace(self) -> Expr: ...
    def determinant(self) -> Expr: ...
    def evaluate(self, values: Sequence[float]) -> NDArray[np.float64]: ...


