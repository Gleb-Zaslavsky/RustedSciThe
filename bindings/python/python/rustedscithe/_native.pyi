class RustedSciTheError(Exception):
    category: str | None
    stage: str | None
    solver: str | None
    route: str | None
    native_kind: str | None


class InvalidExpressionError(RustedSciTheError): ...
class UnsupportedOptionError(RustedSciTheError): ...
class InvalidConfigurationError(RustedSciTheError): ...
class SolverError(RustedSciTheError): ...
class PreparationError(RustedSciTheError): ...
class AotArtifactError(PreparationError): ...
class AotCompilerError(PreparationError): ...
class AotLinkError(PreparationError): ...
class AotTimeoutError(PreparationError): ...
class AotLifecycleError(PreparationError): ...
class CallbackError(RustedSciTheError): ...
class ExhaustionError(RustedSciTheError): ...
class TaskDocumentError(RustedSciTheError): ...
class BvpError(RustedSciTheError): ...
class TelemetryError(RustedSciTheError): ...
class PanicError(RustedSciTheError):
    solver_state: Literal["discard"] | None
    execution_state: Literal["discard"] | None


class PoisonedSolverError(SolverError): ...


class Expr:
    """Native symbolic scalar expression."""

    @staticmethod
    def variable(name: str) -> Expr: ...
    @staticmethod
    def constant(value: float) -> Expr: ...
    @staticmethod
    def parse(text: str) -> Expr: ...
    def diff(self, variable: str) -> Expr: ...
    def substitute(self, variable: str, value: float) -> Expr: ...
    def substitute_expr(self, variable: str, value: Expr) -> Expr: ...
    def substitute_many(self, replacements: Sequence[tuple[str, Expr]]) -> Expr: ...
    def where_substitute(self, replacements: Mapping[str, Expr]) -> Expr: ...
    def lambdify(self, variables: Sequence[str] | None = None) -> LambdifiedExpr: ...
    def variables(self) -> list[str]: ...
    def evaluate(self, values: Sequence[float]) -> float: ...
    def simplify(self) -> Expr: ...
    def exp(self) -> Expr: ...
    def ln(self) -> Expr: ...
    def sin(self) -> Expr: ...
    def cos(self) -> Expr: ...
    def tan(self) -> Expr: ...
    def asin(self) -> Expr: ...
    def acos(self) -> Expr: ...
    def atan(self) -> Expr: ...
    def acot(self) -> Expr: ...
    def arcsin(self) -> Expr: ...
    def arccos(self) -> Expr: ...
    def arctg(self) -> Expr: ...
    def arcctg(self) -> Expr: ...
    def pow(self, exponent: Expr) -> Expr: ...
    def __add__(self, rhs: Expr) -> Expr: ...
    def __sub__(self, rhs: Expr) -> Expr: ...
    def __mul__(self, rhs: Expr) -> Expr: ...
    def __truediv__(self, rhs: Expr) -> Expr: ...
    def __pow__(self, rhs: Expr) -> Expr: ...
    def __neg__(self) -> Expr: ...


def parse_expr(text: str) -> Expr: ...
def symbol(name: str) -> Expr: ...
def constant(value: float) -> Expr: ...


