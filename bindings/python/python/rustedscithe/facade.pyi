"""Typed declarations for the Python-native convenience helpers."""

from collections.abc import Iterable, Mapping
from pathlib import Path
from typing import Any, Literal, TypeAlias, overload

from numpy.typing import ArrayLike

from ._native import (
    BackwardEulerSolution,
    BackwardEulerSolver,
    BdfSolution,
    BdfSolver,
    BvpDampSolution,
    BvpDampSolver,
    BvpSciSolution,
    BvpSciSolver,
    Expr,
    FittingSolution,
    FittingSolver,
    Lsode2Solution,
    Lsode2Solver,
    NonlinearSolution,
    NonlinearSolver,
    RadauSolution,
    RadauSolver,
    SolverCapabilities,
    SolverOptions,
    SymbolicSystem,
    TaskDocument,
)

_IvpSolver: TypeAlias = BdfSolver | RadauSolver | BackwardEulerSolver | Lsode2Solver
_IvpSolution: TypeAlias = BdfSolution | RadauSolution | BackwardEulerSolution | Lsode2Solution
_BvpSolver: TypeAlias = BvpSciSolver | BvpDampSolver
_BvpSolution: TypeAlias = BvpSciSolution | BvpDampSolution

def capabilities(solver: str) -> SolverCapabilities: ...

@overload
def create_ivp(method: Literal["bdf"], expressions: list[Expr], state_variables: list[str], time_variable: str, y0: ArrayLike, t0: float, t_end: float, max_step: float, *, parameters: list[str] | None = ..., parameter_values: ArrayLike | None = ..., options: SolverOptions | None = ..., controller: str | None = ..., **solver_options: Any) -> BdfSolver: ...
@overload
def create_ivp(method: Literal["radau", "radau5"], expressions: list[Expr], state_variables: list[str], time_variable: str, y0: ArrayLike, t0: float, t_end: float, max_step: float, *, parameters: list[str] | None = ..., parameter_values: ArrayLike | None = ..., options: SolverOptions | None = ..., controller: str | None = ..., **solver_options: Any) -> RadauSolver: ...
@overload
def create_ivp(method: Literal["be", "backward_euler"], expressions: list[Expr], state_variables: list[str], time_variable: str, y0: ArrayLike, t0: float, t_end: float, max_step: float, *, parameters: list[str] | None = ..., parameter_values: ArrayLike | None = ..., options: SolverOptions | None = ..., controller: str | None = ..., **solver_options: Any) -> BackwardEulerSolver: ...
@overload
def create_ivp(method: Literal["lsode", "lsode2"], expressions: list[Expr], state_variables: list[str], time_variable: str, y0: ArrayLike, t0: float, t_end: float, max_step: float, *, parameters: list[str] | None = ..., parameter_values: ArrayLike | None = ..., options: SolverOptions | None = ..., controller: str | None = ..., **solver_options: Any) -> Lsode2Solver: ...
@overload
def create_ivp(method: str, expressions: list[Expr], state_variables: list[str], time_variable: str, y0: ArrayLike, t0: float, t_end: float, max_step: float, *, parameters: list[str] | None = ..., parameter_values: ArrayLike | None = ..., options: SolverOptions | None = ..., controller: str | None = ..., **solver_options: Any) -> _IvpSolver: ...

@overload
def solve_ivp(method: Literal["bdf"], expressions: list[Expr], state_variables: list[str], time_variable: str, y0: ArrayLike, t0: float, t_end: float, max_step: float, *, parameters: list[str] | None = ..., parameter_values: ArrayLike | None = ..., options: SolverOptions | None = ..., controller: str | None = ..., **solver_options: Any) -> BdfSolution: ...
@overload
def solve_ivp(method: Literal["radau", "radau5"], expressions: list[Expr], state_variables: list[str], time_variable: str, y0: ArrayLike, t0: float, t_end: float, max_step: float, *, parameters: list[str] | None = ..., parameter_values: ArrayLike | None = ..., options: SolverOptions | None = ..., controller: str | None = ..., **solver_options: Any) -> RadauSolution: ...
@overload
def solve_ivp(method: Literal["be", "backward_euler"], expressions: list[Expr], state_variables: list[str], time_variable: str, y0: ArrayLike, t0: float, t_end: float, max_step: float, *, parameters: list[str] | None = ..., parameter_values: ArrayLike | None = ..., options: SolverOptions | None = ..., controller: str | None = ..., **solver_options: Any) -> BackwardEulerSolution: ...
@overload
def solve_ivp(method: Literal["lsode", "lsode2"], expressions: list[Expr], state_variables: list[str], time_variable: str, y0: ArrayLike, t0: float, t_end: float, max_step: float, *, parameters: list[str] | None = ..., parameter_values: ArrayLike | None = ..., options: SolverOptions | None = ..., controller: str | None = ..., **solver_options: Any) -> Lsode2Solution: ...
@overload
def solve_ivp(method: str, expressions: list[Expr], state_variables: list[str], time_variable: str, y0: ArrayLike, t0: float, t_end: float, max_step: float, *, parameters: list[str] | None = ..., parameter_values: ArrayLike | None = ..., options: SolverOptions | None = ..., controller: str | None = ..., **solver_options: Any) -> _IvpSolution: ...
